{
    "compilerOptions": {
        "strict": true,
        // "declaration": true,
        "target": "es5",
        "lib": [
            "dom",
            "es2020"
        ],
        "jsx": "react",
        "module": "esnext", // "esnext",
        "esModuleInterop": true,
        "allowJs": false, // false
        "allowSyntheticDefaultImports": true,
        "noImplicitAny": false,
        "moduleResolution": "node",
        "skipLibCheck": true,
        "noUnusedLocals": false,
        "sourceMap": false, // true
        "types": [],
    },
    "include": [
        "src/**/*"
    ],
}