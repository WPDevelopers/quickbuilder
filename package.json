{
    "name": "quickbuilder",
    "version": "1.0.1",
    "author": "priyomukul",
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "pnpm@11.6.0",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "repository": {
        "type": "git",
        "url": "https://github.com/priyomukul/wp-react-form.git"
    },
    "files": [
        "dist/**",
        "package.json"
    ],
    "scripts": {
        "predev": "rimraf dist/dev",
        "start": "npm run predev && rollup -c --bundleConfigAsCjs -w --environment NODE_ENV:development",
        "dev": "npm run predev && rollup -c --bundleConfigAsCjs --environment NODE_ENV:development",
        "prepkg": "rimraf dist/src",
        "pkg": "npm run prepkg && rollup -c --bundleConfigAsCjs --environment NODE_ENV:production",
        "build": "npm run dev && npm run pkg",
        "lint": "eslint index.tsx src --ext .ts,.tsx,.js,.jsx"
    },
